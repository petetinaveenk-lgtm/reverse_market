# Backend REST API base URL
# For local development with Vite dev server (npm run dev):
VITE_API_BASE_URL=http://localhost:8081

# For production behind Nginx reverse proxy (same domain), set empty:
# VITE_API_BASE_URL=

# For production on separate domain/cloud service (e.g. Render / Vercel):
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

